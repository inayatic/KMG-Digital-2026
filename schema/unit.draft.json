{
  "$comment": "DRAFT: единица главы, build/<ch>/units.json (список). Делает tools/make_units.py.",
  "type": "object",
  "required": ["id", "type", "page", "text"],
  "properties": {
    "id": {"type": "string", "pattern": "^p[0-9]{3}-[0-9]{2}$"},
    "type": {"enum": ["paragraph", "heading", "formula", "table", "caption", "footnote", "example", "problem", "figure_desc"]},
    "page": {"type": "integer", "description": "PDF-страница"},
    "section": {"type": "string"},
    "text": {"type": "string"}
  }
}
